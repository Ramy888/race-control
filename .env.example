TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/callback
BROADCASTER_LOGIN=
BOT_LOGIN=
PORT=3000

# npm run mock sets MOCK=1 automatically (no Twitch credentials needed).
MOCK=0

# Runtime AI dares via Codex CLI; set off for deterministic offline samples.
GAME=Fortnite
GAMEMASTER=on

# OBS v5 WebSocket server (Tools > WebSocket Server Settings).
OBS_URL=ws://127.0.0.1:4455
# Optional; leave empty when OBS authentication is disabled.
OBS_PASSWORD=
# Empty disables Watcher. Use Test HUD for the demo Browser Source.
WATCHER_SOURCE=
# Normalized x,y,width,height from top-left; matches /hud-test at 1920x1080.
HUD_REGION=0.85,0.1,0.1,0.1
# Poll cadence in milliseconds; only one screenshot/OCR read at a time.
WATCHER_MS=2000

# Optional Ledger and timings; npm run demo overrides these with isolated demo settings.
LEDGER_PATH=.data/ledger.jsonl
VOTE_SECONDS=30
SECONDS_PER_KILL=30
MIN_DARE_SECONDS=90
